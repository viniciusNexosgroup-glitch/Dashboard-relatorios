# =============================================
# BANCO DE DADOS (Supabase PostgreSQL)
# =============================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# =============================================
# NEXTAUTH
# Gere o secret com: openssl rand -base64 32
# =============================================
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="https://dashboard.seudominio.com"

# =============================================
# META ADS API
# Obter em: https://developers.facebook.com/
# App precisa de permissoes: ads_read, ads_management
# =============================================
META_APP_ID=""
META_APP_SECRET=""
# Token de longa duracao (60 dias) - gerado pelo sistema de OAuth
META_SYSTEM_USER_TOKEN=""

# =============================================
# GOOGLE ADS API
# Obter em: https://console.cloud.google.com/
# =============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_DEVELOPER_TOKEN=""
GOOGLE_REFRESH_TOKEN=""
# ID do cliente gerenciador (MCC), se usar
GOOGLE_MANAGER_CUSTOMER_ID=""

# =============================================
# EVOLUTION API (WhatsApp)
# Sua instancia do Evolution API
# =============================================
EVOLUTION_API_URL="https://sua-instancia.evolution-api.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="agencia"

# =============================================
# CONFIGURACOES DO SISTEMA
# =============================================
NEXT_PUBLIC_APP_URL="https://dashboard.seudominio.com"
NEXT_PUBLIC_AGENCY_NAME="Minha Agencia"

# =============================================
# CRON (gerar com: openssl rand -base64 32)
# Usado pelos jobs internos (sync 8h/14h/20h, relatorio mensal dia 1)
# =============================================
CRON_SECRET=""
